# Supabase (frontend / Vercel)
# Get these from: Supabase Dashboard -> Project Settings -> API
#
# Vite inlines VITE_* at BUILD time. Vercel: changing a value here (or in
# the Vercel dashboard) requires a redeploy — saving is not enough.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional auth event logging (src/auth/authDebug.js). Never logs tokens,
# only token expiry, refresh interval, and error status/message.
VITE_AUTH_DEBUG=false